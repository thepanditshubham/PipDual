# ── Pip Duel environment ──────────────────────────────────────────────
# Copy to `.env.local` and fill in. Never commit a real key.
# `.env*` is ignored by git except this example.

# Supabase ────────────────────────────────────────────────────────────
# Optional for local guest and bot play. Required for sign-in, friends,
# mail, the global leaderboard and 1v1 matchmaking over Realtime.
# Create a project at https://supabase.com, then run supabase/setup.sql
# in the SQL editor (or `supabase db push` with the CLI).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The anon key is public by design and ships to the browser. Do NOT put a
# service-role key in a NEXT_PUBLIC_* variable. The application does not
# need a service-role key; if you add server-side jobs, keep that key in a
# server-only variable and never import it into a client component.

# Site ────────────────────────────────────────────────────────────────
# Used for absolute links (invites, metadata). `http://localhost:3000` in
# development; your public origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Community ───────────────────────────────────────────────────────────
# Optional. The invite button is hidden when this is empty.
NEXT_PUBLIC_DISCORD_INVITE=

# This project is free-to-play and virtual-currency only. No payment,
# deposit, withdrawal, wallet-address or blockchain variables belong in a
# public configuration. See docs/OSS_RELEASE_REPORT.md.
