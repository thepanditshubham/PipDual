# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coin deposit wallet addresses
# One house address per rail. A rail with no address here is hidden from the
# deposit screen rather than shown blank, so leave one unset to pause it.
# These are inlined at build time — restart `next dev` after editing.
# Deposits stay uncredited until an admin approves them at /admin/deposits.
# Rails: USDT-TRC20, USDT-BEP20 (BSC), USDT-ERC20, BTC, ETH, SOL, XRP.
# A QR for a rail lives in /public and is wired in src/lib/economy/config.ts.
NEXT_PUBLIC_DEPOSIT_USDT_TRC20=
NEXT_PUBLIC_DEPOSIT_USDT_BEP20=0xYourHouseAddress
NEXT_PUBLIC_DEPOSIT_USDT_ERC20=
NEXT_PUBLIC_DEPOSIT_BTC=
NEXT_PUBLIC_DEPOSIT_ETH=
NEXT_PUBLIC_DEPOSIT_SOL=
NEXT_PUBLIC_DEPOSIT_XRP=

# Chain RPC (optional — no API key needed)
# The deposit desk reads a transfer straight from a public JSON-RPC node
# (BSC and Ethereum mainnet). Point these at your own endpoint if the public
# ones rate-limit you.
CHAIN_RPC_BEP20=
CHAIN_RPC_ERC20=
